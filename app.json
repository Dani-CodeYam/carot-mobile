{
  "expo": {
    "name": "El Carot",
    "slug": "carot-mobile",
    "version": "1.0.0",
    "scheme": [
      "carot",
      "com.googleusercontent.apps.934983528266-36vtt476b4d1l3qq4icsv7r7ki6a7b2d"
    ],
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "backgroundColor": "#202020",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#202020"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleIosClientId": "934983528266-36vtt476b4d1l3qq4icsv7r7ki6a7b2d.apps.googleusercontent.com"
    },
    "ios": {
      "bundleIdentifier": "com.elcarot.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.elcarot.mobile",
      "backgroundColor": "#202020",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#202020"
      }
    }
  }
}
