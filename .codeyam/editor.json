{
  "$comment": "Per-developer settings (port, provider, proxy ports, startCommand, etc.) belong in editor.local.json. That file is gitignored and is deep-merged on top of this one at load time. See CLAUDE.md or run `codeyam-editor editor config-show` to inspect the effective config.",
  "projectTitle": "El Carot",
  "projectDescription": "A tarot reading app for mobile — daily card draws and spreads",
  "provider": "claude",
  "startCommand": "NODE_OPTIONS=--dns-result-order=ipv4first BROWSER=none npx expo start --web --port 8083 --host localhost",
  "port": 8083,
  "env": {},
  "toolchainPaths": [],
  "proxy": {
    "httpPort": 14100,
    "dbPort": 14101,
    "controlPort": 14199,
    "httpsPassthrough": [
      "crates.io",
      "static.crates.io",
      "index.crates.io",
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "proxy.golang.org",
      "sum.golang.org",
      "storage.googleapis.com",
      "rubygems.org",
      "github.com",
      "codeload.github.com",
      "objects.githubusercontent.com"
    ],
    "httpsPreview": false
  },
  "database": null,
  "scenarios": {
    "dir": ".codeyam/scenarios"
  },
  "hooks": {},
  "testRunners": [
    {
      "name": "tests",
      "command": "npx jest --json --testLocationInResults",
      "outputFormat": "jest-json",
      "testFilePatterns": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx"
      ],
      "sourceFilePatterns": [
        "**/*.{ts,tsx,js,jsx}"
      ],
      "excludePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**"
      ],
      "coverageExcludePaths": [],
      "changedCommand": "npx jest --json --testLocationInResults {changed_test_files} {changed_source_files:--findRelatedTests}",
      "targetedCommand": "npx jest --json --testLocationInResults -t \"{test_names}\""
    }
  ],
  "testPartitions": [],
  "staticChecks": [
    {
      "name": "tsc",
      "command": "npx tsc --noEmit",
      "filePatterns": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "excludePatterns": [
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**"
      ],
      "description": "TypeScript strict type-check"
    }
  ],
  "formatters": [],
  "screenSizes": {
    "iPhone 16": {
      "width": 393,
      "height": 852
    },
    "iPad": {
      "width": 820,
      "height": 1180
    },
    "iPhone 16 Pro Max": {
      "width": 430,
      "height": 932
    }
  },
  "defaultScreenSize": "iPhone 16",
  "apps": [
    {
      "name": "El Carot",
      "type": "mobile",
      "dir": ".",
      "startCommand": "NODE_OPTIONS=--dns-result-order=ipv4first BROWSER=none npx expo start --web --port 8083 --host localhost"
    }
  ],
  "files": {
    "textLogMaxBytes": null,
    "eventLogMaxBytes": null,
    "logKeepRotated": null,
    "journalShardEntries": null
  },
